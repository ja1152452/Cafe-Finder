# ==============================================================================
# CafeFinder — Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Database Connection (Default: SQLite for instant zero-config local dev)
# For PostgreSQL (e.g. Docker), use: postgresql://postgres:postgres@localhost:5432/cafefinder?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secret for User Session Signing
JWT_SECRET="cafefinder-super-secret-jwt-key-change-in-production-12345"
JWT_EXPIRES_IN="7d"

# CORS Origin for Web Frontend
CORS_ORIGIN="http://localhost:5173"

# Google Maps Platform API Keys
# 1. GOOGLE_MAPS_API_KEY (Used by Backend for Geocoding, Places, and Directions)
# 2. VITE_GOOGLE_MAPS_API_KEY (Used by Frontend for Google Maps JavaScript Loader)
# Note: If left blank or mock, CafeFinder automatically activates its high-fidelity
# offline dataset with interactive map canvas, authentic reviews, and coordinates!
GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACES_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

# Cache TTL for Google API responses (in seconds, default: 3600 = 1 hour)
CACHE_TTL_SECONDS=3600

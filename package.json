{
  "name": "cafefinder-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CafeFinder - Full-Featured Modern Cafe Discovery Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:push": "npm run db:push --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api"
  },
  "keywords": [
    "cafe-finder",
    "google-maps",
    "google-places",
    "react",
    "typescript",
    "express",
    "prisma"
  ],
  "author": "CafeFinder Team",
  "license": "MIT"
}
